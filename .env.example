# Copy to .env — NEVER commit .env
GNANI_API_KEY_ID=
GNANI_BASE_URL=https://api.vachana.ai
TELEGRAM_BOT_TOKEN=
# Optional disclosed LLM for span extraction only (code computes all money)
GROQ_API_KEY=
# 1 = also ask the LLM for a third opinion on spans (sends transcripts to Groq); 0 = off
MUNIM_LLM_SPANS=0
MUNIM_LLM_MODEL=llama-3.3-70b-versatile
MUNIM_SHOP_NAME=Dukaan
# Secret for HMAC customer pseudonyms in the ledger (generate: python -c "import secrets;print(secrets.token_hex(32))")
MUNIM_HMAC_SECRET=
MUNIM_ROOT=data
# 1 = anyone may create a shop with /newshop (capped per day); 0 = closed
MUNIM_OPEN_SIGNUP=1
MUNIM_MAX_NEW_SHOPS_PER_DAY=50
# Credit budget guard: stop spending below this many credits remaining (internal meter)
MUNIM_CREDIT_FLOOR=300
MUNIM_STARTING_CREDITS=5000

# Opt-in: photo of a paper khata is sent to the LLM provider (vision). 0 = off
MUNIM_SCAN=0
MUNIM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# REST API /metrics
MUNIM_ADMIN_TOKEN=

# --- v4 channels & features (all optional; see docs/EDGE.md, docs/V4_FEATURES.md) ---
MUNIM_EDGE=0
MUNIM_SMS=0
MUNIM_WA_APP_SECRET=
MUNIM_WA_TOKEN=
MUNIM_WA_PHONE_ID=
MUNIM_WA_VERIFY_TOKEN=
# comma-separated chat ids allowed to run pool admin actions
MUNIM_POOL_ADMINS=
# sovereign / alternative LLM (OpenAI-compatible). provider=evon requires BASE_URL
MUNIM_LLM_PROVIDER=
MUNIM_LLM_BASE_URL=
MUNIM_LLM_API_KEY=
# voice clone endpoints (UNVERIFIED defaults)
GNANI_VC_PATH=
GNANI_VC_TTS_PATH=
